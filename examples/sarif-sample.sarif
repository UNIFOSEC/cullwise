{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "py/sql-injection",
              "name": "SqlInjection",
              "properties": { "tags": ["security", "external/cwe/cwe-089"], "security-severity": "8.8" }
            },
            {
              "id": "py/weak-sensitive-data-hashing",
              "name": "WeakHash",
              "properties": { "tags": ["security", "external/cwe/cwe-327"], "security-severity": "5.0" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "py/sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "This SQL query depends on a user-provided value." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/db.py" },
                "region": { "startLine": 42, "endLine": 42, "snippet": { "text": "cursor.execute(\"... '%s'\" % name)" } }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "a1b2c3d4e5" }
        },
        {
          "ruleId": "py/weak-sensitive-data-hashing",
          "ruleIndex": 1,
          "level": "warning",
          "message": { "text": "Sensitive data is hashed using MD5, a broken algorithm." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/util.py" },
                "region": { "startLine": 5, "endLine": 5 }
              }
            }
          ]
        }
      ]
    }
  ]
}
